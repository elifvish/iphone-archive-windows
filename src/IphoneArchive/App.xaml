<Application x:Class="IphoneArchive.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#172033" />
    <SolidColorBrush x:Key="MutedBrush" Color="#647087" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DEE4EE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F9D73" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="Padding" Value="16" />
      <Setter Property="MinHeight" Value="82" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#AEB8CC" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="NavChrome" Background="Transparent" CornerRadius="9" Padding="13,11"><ContentPresenter /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="#19253B" /><Setter Property="Foreground" Value="White" /></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="#263553" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,9" /><Setter Property="MinHeight" Value="40" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10,7" /><Setter Property="MinHeight" Value="40" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="Background" Value="White" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5" /><Setter Property="VerticalGridLinesBrush" Value="Transparent" />
      <Setter Property="RowHeight" Value="43" /><Setter Property="ColumnHeaderHeight" Value="42" />
    </Style>
  </Application.Resources>
</Application>
